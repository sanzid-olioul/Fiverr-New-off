@model LancasterCreditCardDiversion.ViewModels.CaseCommentViewModel

@{
    ViewData["Title"] = "Add Comment";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="content">
    <div class="row">
        <h2>Add New Comment</h2>
        <div class="col-md-6">
            <form id="addCommentForm" asp-action="AddComment" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-group mb-3 validation-gap">
                    <ejs-textbox multiline="true" id="commentText" type="text" placeholder="New Comment" required="required" floatLabelType=Auto value="@Model.CommentText" asp-for="CommentText"></ejs-textbox>
                    <span asp-validation-for="CommentText" class="text-danger"></span>
                </div>

                <div class="form-group mb-3 d-flex justify-content-between">
                    <a asp-action="ListComments" class="btn btn-secondary">Back to Comments</a>
                    <input type="submit" value="Add" class="btn btn-primary" />
                </div>
            </form>
        </div> 
    </div>
</div>

<style>
    .content {
        margin-top: 130px !important;
    }

    .row {
        margin-left: 0 !important;
    }
</style>
