@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    var fullName = HttpContextAccessor.HttpContext?.Session.GetString("FullName");
}

@if (fullName == null)
{
    <div class="hamburger-with-logo-flex">
        @* <img src="~/NameOfTheLogoFile" alt="Logo" style="width:300px" /> *@
    </div>
    <li class="header-login-page"><h3>LANCASTER COUNTY - CREDIT CARD DIVERSION PROGRAM</h3></li>
}

<li>
    @if (fullName != null)
    {
        <div class="hamburger-with-logo-flex">
            <div id="hamburger">
                <div></div>
            </div>
            @* <img src="~/NameOfTheLogoFile" alt="Logo" style="width:300px" /> *@
        </div>
       <li><h3>LANCASTER COUNTY - CREDIT CARD DIVERSION PROGRAM</h3></li>
       @*  <ejs-dropdownbutton style="position:absolute;z-index:1001;" id="left-icon" items="ViewBag.items" iconCss="ddb-icons e-user">@username</ejs-dropdownbutton> *@
         <div class="dropdown-custom" style="float:right;">
             <button class="dropbtn" id="log-out" onclick="toggleDropdown(event)"><i class='fas fa-user-alt' style='font-size:12px'></i>&nbsp; @fullName</button>
             <div class="dropdown-content">
                 <a href="@Url.Action("Logout", "Auth")">Logout</a>
             </div>
         </div>
    }
</li>

<style>
    .dropbtn {
        background-color: #f5f5f5;
        color: black; 
        padding: 10px;
        font-size: 15px;
        box-shadow: 0px 8px 16px 0px rgba(0,0,0,0.2);
        cursor: pointer;
        border: none;
        border-radius: 5px;
    }

    .dropdown-custom {
        position: relative;
        display: inline-block;
    }

    .dropdown-content {
        display: none;
        position: absolute;
        right: 0;
        background-color: #f9f9f9;
        min-width: 160px;
        box-shadow: 0px 8px 16px 0px rgba(0,0,0,0.2);
        z-index: 1001;
        cursor:pointer;
    }

    .dropdown-content a {
        color: black;
        padding: 10px 14px;
        text-decoration: none;
        display: block;
    }

    .dropdown-content a:hover {
        background-color: #f1f1f1;
    }

    .dropdown-show .dropdown-content {
        display: block; /* Show dropdown when class 'dropdown-show' is added */
    }

    button{
        margin: 25px 5px 10px 20px;
    }

    @@media(max-width: 1346px) {
        h3 {
            font-size: 22px;
            margin: 0; 
        }

        .dropdown-custom .dropbtn {
            font-size: 12px; 
            padding: 6px; 
        }

        .dropdown-content a {
            font-size: 15px; 
            padding: 6px 10px; 
        }

        .hamburger-with-logo-flex img {
            width: 220px !important; 
            height: auto; 
        }

        #hamburger {
            width: 22px !important; /* Smaller width for hamburger */
        }

            #hamburger:before,
            #hamburger:after,
            #hamburger div {
                height: 2px; 
                margin: 3px 0;
            }
    }

    @@media(max-width: 846px) {
        h3 {
            font-size: 18px !important;
            margin: 0;
        }

        .dropdown-custom .dropbtn {
            font-size: 9px;
            padding: 4px;
        }

        .dropdown-content a {
            font-size: 12px;
            padding: 6px 10px;
        }

        .hamburger-with-logo-flex img {
            width: 200px !important;
            height: auto;
        }

        #hamburger {
            width: 20px !important; /* Smaller width for hamburger */
        }

            #hamburger:before,
            #hamburger:after,
            #hamburger div {
                height: 2px;
                margin: 3px 0;
            }
    }


    @@media(max-width: 410px) {
        h3 {
            font-size: 15px !important;
            margin: 0;
        }

        .dropdown-custom .dropbtn {
            font-size: 9px;
            padding: 4px;
        }

        .dropdown-content a {
            font-size: 12px;
            padding: 6px 10px;
        }

        .hamburger-with-logo-flex img {
            width: 180px !important;
            height: auto;
        }

        #hamburger {
            width: 18px !important; /* Smaller width for hamburger */
        }

            #hamburger:before,
            #hamburger:after,
            #hamburger div {
                height: 2px;
                margin: 3px 0;
            }
    }


</style>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        sidebarInstance = document.getElementById('sidebar-menu').ej2_instances[0];

        document.getElementById('hamburger').onclick = function () {
            sidebarInstance.toggle();
        };
    });

    function toggleDropdown(event) {
        const dropdown = event.currentTarget.parentElement;
        dropdown.classList.toggle('dropdown-show');
    }

    window.onclick = function (event) {
        if (!event.target.matches('.dropbtn')) {
            const dropdowns = document.getElementsByClassName("dropdown-custom");
            for (let i = 0; i < dropdowns.length; i++) {
                dropdowns[i].classList.remove('dropdown-show');
            }
        }
    }
</script>
