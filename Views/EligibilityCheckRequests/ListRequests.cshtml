    async function viewResult(caseId, reqId) {
        try {
            const response = await fetch(`/EligibilityCheckRequests/AIResponse/${caseId}/${reqId}`, {
                method: 'GET',
                headers: { 'Content-Type': 'application/json' }
            });
            const data = await response.json();

            if (data.success) {
                const formattedResults = formatResults(data.response, data.documentNames);
                showModal(formattedResults);
            } else {
                showModal('No results found.');
            }
        } catch (error) {
            console.error('Error:', error);
            showModal('An error occurred while fetching results.');
        }
    }

     window.addEventListener('click', function (event) {
        const modal = document.getElementById('showModal');
        const overlay = document.getElementById('overlay');

        if (modal.style.display === 'block' && !modal.contains(event.target) && !event.target.closest('.popup-modal')) {
            closeModal();
        }
    });

</script>

<style>
      #template{
        text-align:left;
    }

    .analysis-header {
        font-size: 24px; /* Adjust size as needed */
        font-weight: bold;
        margin-bottom: 10px;
        font-family: "Inter", sans-serif;
