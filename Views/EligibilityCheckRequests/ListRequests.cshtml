@* @model IEnumerable<LancasterCreditCardDiversion.ViewModels.EligibilityCheckRequestViewModel> *@

@model IEnumerable<LancasterCreditCardDiversion.ViewModels.ResponsesApiRequestsViewModel>

@{
    ViewData["Title"] = "OpenAI Requests";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var message = TempData["Message"] as string;
    var messageType = TempData["MessageType"] as string;
}

@if (!string.IsNullOrEmpty(message))
{
    <div class="popup-alert popup-alert-@messageType" role="alert" data-has-message="true">
        <button class="close-btn" onclick="this.parentElement.style.display='none';">&times;</button>
        @message
    </div>
}
else
{
    <div class="popup-alert" data-has-message="false" style="display: none;"></div>
}

<div id="overlay" class="overlay" style="display: none;"></div>
<div id="showModal" class="popup-alert-custom popup-alert-info" style="display: none;" role="alert">
    <button class="close-btn" onclick="closeModal()">&times;</button>
    <span id="modalMessage"></span>
</div>

<div class="content">
 
    <ejs-grid id="RequestGrid" dataSource="@Model" showColumnMenu="true" allowFiltering="true" allowSelection="true" allowTextWrap="true" allowResizing="true" allowPaging="true" allowSorting="true" toolbarTemplate="#template">
                <e-grid-filterSettings type="Excel"></e-grid-filterSettings>
                <e-grid-pageSettings pageCount="5" pageSize="12" pageSizes="true" />
                    <e-grid-columns>
                         <e-grid-column field="EligibilityCheckStatus" headerText="Status" width="100"></e-grid-column>
                         <e-grid-column field="DocumentNames" headerText="Doc Name(s)" width="200"></e-grid-column>
                         <e-grid-column field="CreatedDttm" headerText="Date" width="100" format="MMM dd, yyyy hh:mm a"></e-grid-column>
                         <e-grid-column headerText="Results" width="150" template="#resultsTemplate"></e-grid-column>
                    </e-grid-columns>
            </ejs-grid>

    <div id="template">
        <ejs-toolbar id="defaultToolbar" clicked="clickHandler">
            <e-toolbar-items>
                <e-toolbar-item id="queue" prefixIcon="e-thumbnail" text="Queue (@ViewBag.QueueCount)"></e-toolbar-item>
                <e-toolbar-item id="refresh" prefixIcon="e-refresh" text="Refresh"></e-toolbar-item>

            </e-toolbar-items>
        </ejs-toolbar>
    </div>

</div>

<script id="documentsTemplate" type="text/x-template">
     ${if(DocumentNames && DocumentNames.length > 0)}
        ${for (var i = 0; i < DocumentNames.length; i++)}
             <span>${DocumentNames[i]}</span><br/>
        ${/for}
    ${else}
         <span> No Documents Found </span>
    ${/if}

</script>


<script id="resultsTemplate" type="text/x-template">
    <span>
        ${if(IsChecked)}
            @* <span onclick="viewResult(${JSON.stringify(ThreadId)})" style="cursor: pointer; color: blue; text-decoration: underline;">View Results</span> *@
            <span onclick="viewResult(${CaseId}, ${ReqId})" style="cursor: pointer; color: blue; text-decoration: underline;">View Results</span>
        ${else}
            <span style="color: gray;">Not Checked</span>
        ${/if}
    </span>
</script>
