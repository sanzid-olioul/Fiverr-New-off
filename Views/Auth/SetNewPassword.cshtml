@{
    ViewData["Title"] = "Set New Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var message = TempData["Message"] as string;
    var messageType = TempData["MessageType"] as string;
}

@if (!string.IsNullOrEmpty(message))
{
    <div class="popup-alert popup-alert-@messageType
            " role="alert">
        <button class="close-btn" onclick="this.parentElement.style.display='none';">&times;</button>
        @message
    </div>
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-4">
            <h4 class="text-center mb-4">Set New Password</h4>
            <form method="post" asp-action="SetNewPassword" asp-controller="Auth" class="bg-light p-4 border rounded shadow text-center">
                <div class="form-group">
                    <ejs-textbox type="password" class="form-control" id="newPassword" name="NewPassword" floatLabelType="Auto" placeholder="New Password" />
                </div>
                <div class="form-group">
                    <ejs-textbox type="password" class="form-control" id="confirmPassword" name="ConfirmPassword" floatLabelType="Auto" placeholder="Confirm Password" />
                </div>
                <br />
                <button type="submit" class="btn btn-primary btn-block center">Set Password</button>
            </form>
        </div>
    </div>
</div>

<style>
    form {
        transition: box-shadow 0.3s;
    }

        form:hover {
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
        }
</style>
